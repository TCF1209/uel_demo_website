{
  "tailwindCSS.experimental.configFile": "app/globals.css",
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "cn"],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
