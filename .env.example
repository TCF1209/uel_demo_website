# UEL website environment variables — copy to .env.local

# Public WhatsApp number used by the floating WhatsApp button and product CTAs.
# Format: country code + number, no '+', no spaces. Example: 60123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=60123456789

# Resend API key for the inquiry form (/api/inquiry).
# Get one at https://resend.com — keep this server-only.
RESEND_API_KEY=

# Email address that receives inquiry form submissions.
INQUIRY_RECIPIENT_EMAIL=

# From-address for inquiry emails. Default 'noreply@resend.dev' works for
# Resend's testing domain. For production, verify a domain in Resend and
# set this to e.g. 'noreply@ueloil.com'.
INQUIRY_FROM_EMAIL=noreply@resend.dev
