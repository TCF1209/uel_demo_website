# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude Code per-user state. Use `git add -f .claude/settings.json` if you ever
# want to commit a project-shared settings file.
.claude/

# Screenshots / scratch images at repo root (legitimate assets go in /public)
/image.png
/image*.png
/screenshot*.png
/Screenshot*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
